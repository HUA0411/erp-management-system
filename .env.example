# ===== 数据库（MySQL 8.0）=====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=erp_system

# ===== 服务 =====
PORT=3000
# 必填。服务启动时会强校验：占位值 / 空值 / 长度 < 32 一律拒绝启动。
# 生成：openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ===== 前端 =====
WEB_PORT=5173

# ===== 安全 =====
# 允许跨域的前端来源（逗号分隔）。生产环境必须替换为实际域名，禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 部署在 nginx / 负载均衡后面时设为 1，这样限流按真实客户端 IP 统计。
# 未部署反代时保持 0 —— 开启后客户端可伪造 X-Forwarded-For 绕过限流。
TRUST_PROXY=0
# AI 服务商域名白名单（逗号分隔）。留空表示不限制（仍会拦截 http 和内网地址）。
# 生产环境建议填写，例如：AI_ALLOWED_HOSTS=api.deepseek.com,open.bigmodel.cn
AI_ALLOWED_HOSTS=
# 使用内网自建模型（Ollama / vLLM 等，http + 内网地址）时设为 1。
# 设为 1 会关闭 AI 接口地址的 SSRF 防护，仅在完全可信的内网环境启用。
AI_ALLOW_INSECURE_BASEURL=0
# 加密 ai_config.api_key 用的密钥。留空则从 JWT_SECRET 派生（HKDF）。
# 轮换该密钥会导致已存密文无法解密，需要重新保存一次 AI 配置。
AI_KEY_ENC_SECRET=
